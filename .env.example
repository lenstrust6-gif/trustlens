# TrustLens Environment Variables

## Database
DATABASE_URL=postgresql+asyncpg://trustlens:trustlens@localhost:5432/trustlens

## Cache
REDIS_URL=redis://localhost:6379
CACHE_TTL=259200
REFRESH_PAUSE=false

## YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_FETCH_LIMIT=200

## Amazon Reviews (Rainforest / Oxylabs)
AMAZON_PROVIDER=rainforest
RAINFOREST_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

## AI Processing
GROQ_API_KEY=
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude

## Email
RESEND_API_KEY=

## Monitoring
SENTRY_DSN=

## FastAPI
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
